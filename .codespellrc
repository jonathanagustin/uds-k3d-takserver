[codespell]
# Preserve the original spelling in this checksum-pinned upstream patch context.
# Captured RGBA pixels are compressed binary data, encoded as base64 in JSON.
skip = atak/scenarios/fixtures/atak-marker-radial.json,./atak/scenarios/fixtures/atak-marker-radial.json,takx/cot-conformance/official/*,./takx/cot-conformance/official/*,./bench/fixtures/tester/tak_tester.py.txt,*.tar,*.tar.zst,pnpm-lock.yaml,build,node_modules,.git,zarf-sbom,tests/.playwright,dist,package-lock.json,LICENSE,./upstream,docs-site/dist,docs-site/.astro,docs-site/src/content/docs,docs-site/test-results,docs-site/playwright-report,docs-site/blob-report,./pepr/mutation/reports/*,./pepr/mutation/.stryker-tmp/*,./takx/compat/mutation/target/*,./takx/native-assimp/patches/assimp-public-static-core.patch,./takx/kernel-scene/patches/libkml-pgsc.patch,./takx/native-cesium/ports,./takx/native-cesium/cesium-tree.json,./takx/native-kml/patches/libkml-pgsc.patch,./takx/kernel-native/core-sqlcipher.map
ignore-words-list = AKS,aks,intoto,thirdparty,inMutable
