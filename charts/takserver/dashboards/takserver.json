{
  "uid": "takserver",
  "title": "TAK Server",
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "30s",
  "tags": ["takserver"],
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "JVM heap",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "jvm_memory_used_bytes{namespace=\"takserver\", area=\"heap\"}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "JVM GC",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "rate(jvm_gc_pause_seconds_count{namespace=\"takserver\"}[5m])"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP request rate",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(http_server_requests_seconds_count{namespace=\"takserver\"}[5m]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Postgres ready",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "kube_pod_status_ready{namespace=\"takserver\", pod=~\"takserver-postgresql.*\", condition=\"true\"}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Pod restarts",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "kube_pod_container_status_restarts_total{namespace=\"takserver\"}"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Messaging replicas",
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "kube_deployment_status_replicas_available{namespace=\"takserver\", deployment=\"takserver-messaging\"}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Container memory",
      "gridPos": {"h": 8, "w": 18, "x": 6, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "container_memory_working_set_bytes{namespace=\"takserver\", container!=\"\", container!=\"POD\"}"
        }
      ]
    }
  ]
}
