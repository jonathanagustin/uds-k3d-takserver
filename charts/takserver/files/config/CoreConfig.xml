<?xml version="1.0" encoding="UTF-8"?>
<Configuration xmlns="http://bbn.com/marti/xml/config"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="CoreConfig.xsd">
	<network tomcatMaxPool="300" esyncEnableCache="1" multicastTTL="5">
		<input _name="stdssl" protocol="tls" port="8089" coreVersion="2"/>
		<!-- web connectors -->
		<connector port="8443" _name="https"/>
		<connector port="8444" useFederationTruststore="true" _name="fed_https"/>
		<!-- Certificate enrollment and the OIDC discovery document. Not the browser UI. -->
		<connector port="8446" clientAuth="false" enableAdminUI="false" enableWebtak="false" _name="cert_https"/>
		<!-- Browser UI behind the tenant gateway. charts/takserver/templates/_helpers.tpl renders it. -->
<!-- TAK_WEB_CONNECTOR -->
	</network>
	<auth default="file" x509groups="true" x509tokenAuth="true">
	        <File location="/opt/tak/UserAuthenticationFile.xml"/>
<!-- TAK_OAUTH -->
	</auth>
	<submission ignoreStaleMessages="false" validateXml="false"/>

	<subscription reloadPersistent="false">

	</subscription>

	<repository enable="true" numDbConnections="100" primaryKeyBatchSize="500" insertionBatchSize="500">
		<connection url="jdbc:postgresql://takserver-postgresql:5432/cot" username="postgres" password="postgres" />
	</repository>

	<repeater connectionPoolAutoSize="false" enable="true" numDbConnections="400" periodMillis="3000" staleDelayMillis="15000">
	    <!-- Examples -->
		<repeatableType initiate-test="/event/detail/emergency[@type='911 Alert']" cancel-test="/event/detail/emergency[@cancel='true']" _name="911"/>
		<repeatableType initiate-test="/event/detail/emergency[@type='Ring The Bell']" cancel-test="/event/detail/emergency[@cancel='true']" _name="RingTheBell"/>
		<repeatableType initiate-test="/event/detail/emergency[@type='Geo-fence Breached']" cancel-test="/event/detail/emergency[@cancel='true']" _name="GeoFenceBreach"/>
		<repeatableType initiate-test="/event/detail/emergency[@type='Troops In Contact']" cancel-test="/event/detail/emergency[@cancel='true']" _name="TroopsInContact"/>
	</repeater>

	<dissemination smartRetry="false" enabled="true"/>

	<filter>
		<flowtag enable="false" text="" />
		<streamingbroker enable="true" />

		<scrubber enable="false" action="overwrite" />

		<qos enabled="false">
            <reportingRateLimiter>
                <rateLimitRule clientThresholdCount="1000" reportingRateLimitSeconds="120" />
                <rateLimitRule clientThresholdCount="5000" reportingRateLimitSeconds="180" />
                <rateLimitRule clientThresholdCount="10000" reportingRateLimitSeconds="240" />
                <rateLimitRule clientThresholdCount="25000" reportingRateLimitSeconds="480" />
                <rateLimitRule clientThresholdCount="50000" reportingRateLimitSeconds="960" />
            </reportingRateLimiter>
        </qos>
	</filter>

	<buffer>
		<latestSA enable="true" />
		<queue missionUidLimit="2048" missionContentLimit="2048" />
	</buffer>

	<!-- Enrollment on 8446. The CSR CN must be the OAuth username. O and OU match the CA subject. -->
	<certificateSigning CA="TAKServer">
		<certificateConfig>
			<nameEntries>
				<nameEntry name="O" value="TAK"/>
				<nameEntry name="OU" value="UDS"/>
			</nameEntries>
		</certificateConfig>
		<TAKServerCAConfig
			keystore="JKS"
			keystoreFile="certs/files/ca-signing.jks"
			keystorePass="${TAK_KEYSTORE_PASS}"
			validityDays="30"
			signatureAlg="SHA256WithRSA"/>
	</certificateSigning>

	<security>
		<!-- TLSv1.3 also negotiates 1.2. The tenant gateway requires 1.3, and
		     the OIDC discovery call to Keycloak failed with protocol_version
		     when this was TLSv1.2. -->
		<tls context="TLSv1.3"
			keymanager="SunX509"
			keystore="JKS" keystoreFile="certs/files/takserver.jks" keystorePass="${TAK_KEYSTORE_PASS}"
			truststore="JKS" truststoreFile="certs/files/truststore-root.jks" truststorePass="${TAK_KEYSTORE_PASS}">
		</tls>

	</security>

	<federation allowFederatedDelete="false" allowMissionFederation="true" enableFederation="true">
	  <federation-server port="9000" v1enabled="true" v2port="9001" v2enabled="true">
	    <tls context="TLSv1.2"
		 keymanager="SunX509"
		 keystore="JKS" keystoreFile="certs/files/takserver.jks" keystorePass="${TAK_KEYSTORE_PASS}"
		 truststore="JKS" truststoreFile="certs/files/fed-truststore.jks" truststorePass="${TAK_KEYSTORE_PASS}"/>
	  </federation-server>
	</federation>

	<!-- cacheConfig="false" stops a node loading the config another node put in the
	     Ignite cache when it starts. It does not stop the runtime sync: each node
	     still replaces its config when any node publishes one (see issue #3).
	     Every TAK pod therefore needs its OIDC client secret rendered before it
	     starts, because an unrendered copy that is published reaches every node.
	     The takserver-oidc admission module adds the render init container when
	     each pod is created. -->
	<cluster enabled="true" cacheConfig="false" kubernetes="true" natsClusterID="takserver" natsURL="nats://takserver-nats:4222"/>

</Configuration>
