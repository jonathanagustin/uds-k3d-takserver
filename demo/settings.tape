# Shared look for every chapter. Sourced by demo/tapes/*.tape.
Set Shell "bash"
Set FontFamily "JetBrains Mono"
Set FontSize 18
Set LineHeight 1.25
Set Width 1280
Set Height 720
Set Padding 24
Set Theme "Catppuccin Mocha"
Set WindowBar Colorful
Set BorderRadius 8
Set Margin 0
Set Framerate 24
Set TypingSpeed 28ms
Set CursorBlink false
