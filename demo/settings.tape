# Shared look for every chapter. Sourced by demo/tapes/*.tape.
# 1632x840: the content area of the window frame demo/style.py draws. The
# colours are the demo palette only (demo/style.py).
Set Shell "bash"
Set FontFamily "JetBrains Mono"
Set FontSize 22
Set LineHeight 1.3
Set Width 1632
Set Height 840
Set Padding 32
Set Theme { "name": "UDS demo", "black": "#020617", "red": "#F8FAFC", "green": "#34D399", "yellow": "#F8FAFC", "blue": "#818CF8", "magenta": "#818CF8", "cyan": "#818CF8", "white": "#CBD5E1", "brightBlack": "#CBD5E1", "brightRed": "#F8FAFC", "brightGreen": "#34D399", "brightYellow": "#F8FAFC", "brightBlue": "#818CF8", "brightMagenta": "#818CF8", "brightCyan": "#818CF8", "brightWhite": "#F8FAFC", "background": "#0F172A", "foreground": "#CBD5E1", "selection": "#020617", "cursor": "#818CF8" }
Set BorderRadius 0
Set Margin 0
Set Framerate 30
Set TypingSpeed 75ms
Set CursorBlink false
