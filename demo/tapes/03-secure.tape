# Chapter 3: secure by default. Kept short: the mesh, the generated network
# policy blocking a pod, and the release's signature and provenance.
# demo/record-terminal.sh pulls the released package before recording, so
# the checks here read a local file and do not wait on the network.
# '# caption:' and '# zoom:' lines are read by demo/filters.py, not VHS.
Output "demo/out/03-secure.mp4"
Source "demo/settings.tape"

Hide
Type@5ms "source demo/shell.sh && clear"
Enter
Sleep 1s
Show

Type@70ms "# Ambient mesh (mTLS, no sidecars) and policies generated from the Package CR"
Sleep 500ms
Enter
Sleep 400ms
# caption: Namespace in the Istio ambient mesh, network policies generated by the UDS Operator
# fast
Type@85ms "kubectl get ns takserver -L istio.io/dataplane-mode && kubectl get netpol -n takserver -o name | head -5"
Sleep 350ms
Enter
Sleep 2600ms
Type@70ms "# A pod TAK's policy does not allow, trying TAK's streaming port"
Sleep 500ms
Enter
Sleep 400ms
# caption: A pod in another namespace cannot reach TAK's 8089: the generated network policy drops it
# fast
Type@40ms "kubectl run deny-test -n default --rm -i --restart=Never -l zarf.dev/agent=ignore --image=docker.io/curlimages/curl:8.11.1 -- curl -sS -m 5 telnet://takserver-messaging-service.takserver.svc.cluster.local:8089"
Sleep 400ms
Enter
Wait@120s /takserver \$\s*$/
Sleep 2000ms
Screenshot "demo/out/shots/network-policy-blocks-8089.png"
Sleep 1s
Type@70ms "# Releases are signed keylessly by the release workflow"
Sleep 500ms
Enter
Sleep 400ms
# caption: The published v{{VERSION}} package verifies against the release workflow's signing identity
# fast
Type@30ms "uds zarf package verify {{RELEASE_PACKAGE}} --certificate-identity-regexp $RELEASE_WORKFLOW --certificate-oidc-issuer $RELEASE_ISSUER"
Sleep 400ms
Enter
Wait@60s /takserver \$\s*$/
Sleep 2000ms
Screenshot "demo/out/shots/release-signature-verified.png"
Sleep 1s
# caption: Build provenance for the same package, attested with the release workflow's identity
# fast
Type@40ms "gh attestation verify oci://ghcr.io/jonathanagustin/uds-takserver/takserver:{{VERSION}}-upstream --owner jonathanagustin"
Sleep 400ms
Enter
Wait@120s /takserver \$\s*$/
Sleep 2500ms
Screenshot "demo/out/shots/release-provenance-verified.png"
Sleep 1s
