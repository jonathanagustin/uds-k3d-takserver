# Chapter 3: secure by default.
# '# caption:' and '# zoom:' lines are read by demo/filters.py, not VHS.
Output "demo/out/03-secure.mp4"
Source "demo/settings.tape"

Hide
Type@5ms "source demo/shell.sh && clear"
Enter
Sleep 1s
Show

Type@70ms "# Ambient mesh: mTLS, no sidecars"
Sleep 500ms
Enter
Sleep 400ms
# caption: Namespace enrolled in the Istio ambient mesh
Type@85ms "kubectl get ns takserver -L istio.io/dataplane-mode"
Sleep 350ms
Enter
Sleep 2000ms
Type@65ms "# Policies generated from the Package CR"
Sleep 700ms
Enter
Sleep 400ms
# caption: Network policies generated by the UDS Operator from the CR
Type@90ms "kubectl get netpol -n takserver -o name | head -6"
Sleep 450ms
Enter
Sleep 2600ms
Type@75ms "# Keycloak client secret, written at deploy time"
Sleep 600ms
Enter
Sleep 400ms
# caption: Keycloak client secret created by the UDS Operator
Type@80ms "kubectl get secret takserver-sso -n takserver"
Sleep 400ms
Enter
Sleep 2500ms
# caption: CI workflows include CodeQL, dependency review, scan, cosign, Scorecard
Type@70ms "ls .github/workflows"
Sleep 500ms
Enter
Sleep 2500ms
Type@70ms "# A pod TAK's policy does not allow, trying TAK's streaming port"
Sleep 500ms
Enter
Sleep 400ms
# caption: A pod in another namespace cannot reach TAK's 8089: the generated network policy drops it
Type@40ms "kubectl run deny-test -n default --rm -i --restart=Never -l zarf.dev/agent=ignore --image=docker.io/curlimages/curl:8.11.1 -- curl -sS -m 5 telnet://takserver-messaging-service.takserver.svc.cluster.local:8089"
Sleep 400ms
Enter
Wait@120s /takserver \$ $/
Sleep 2500ms
Type@70ms "# Releases are signed keylessly by the release workflow"
Sleep 500ms
Enter
Sleep 400ms
# caption: The published v0.3.0 package verifies against the release workflow's signing identity
Type@30ms "uds zarf package verify oci://ghcr.io/jonathanagustin/uds-k3d-takserver/takserver:0.3.0-upstream --certificate-identity-regexp $RELEASE_WORKFLOW --certificate-oidc-issuer https://token.actions.githubusercontent.com"
Sleep 400ms
Enter
Wait@180s /takserver \$ $/
Sleep 3000ms
# caption: Build provenance for the same package, attested with the release workflow's identity
Type@40ms "gh attestation verify oci://ghcr.io/jonathanagustin/uds-k3d-takserver/takserver:0.3.0-upstream --owner jonathanagustin"
Sleep 400ms
Enter
Wait@120s /takserver \$ $/
Sleep 3000ms
