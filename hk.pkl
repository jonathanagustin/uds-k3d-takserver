amends "package://github.com/jdx/hk/releases/download/v2.0.0/hk@2.0.0#/Config.pkl"

// Pre-commit and CI. License headers are the shared lint:all task.
steps {
  // --strict fails on warnings too.
  ["yamllint"] {
    check = "yamllint --strict . -c .yamllint"
    glob = List("**/*.yaml", "**/*.yml", ".yamllint")
  }
  // All optional checks are on. SC2310 and SC2312 are off: they flag set -e being
  // suspended in conditions and command substitutions, and "fixing" them changes
  // when a script exits.
  ["shellcheck"] {
    check = "shellcheck --enable=all --severity=style --exclude=SC2310,SC2312 {{files}}"
    glob = List("**/*.sh")
  }
  ["hadolint"] {
    check = "hadolint --config .hadolint.yaml .github/container-and-chart/docker/Dockerfile .github/container-and-chart/cloudtak/Dockerfile .github/container-and-chart/postgis/Dockerfile"
    glob = List("**/Dockerfile", ".hadolint.yaml")
  }
  ["shell"] {
    check = "uds run lint:shell --no-progress --with exclusion=build"
    glob = List("tasks.yaml", "tasks/**/*.yaml", ".github/workflows/**/*.yaml", "zarf.yaml", "common/zarf.yaml")
  }
  ["actionlint"] {
    check = "actionlint"
    glob = List(".github/workflows/*.{yml,yaml}")
  }
  ["codespell"] {
    check = "codespell"
    glob = List("**/*", ".codespellrc")
    exclude = List(
      "build/**",
      "node_modules/**",
      "tests/.playwright/**",
      "tests/pnpm-lock.yaml",
      "*.tar",
      "*.tar.zst",
      "zarf-sbom/**",
      ".git/**",
      "upstream/**"
    )
  }
  ["renovate-config"] {
    check = "uds run lint:renovate --no-progress"
    glob = List("renovate.json")
  }
  ["helm"] {
    check = "uds run lint:helm --no-progress --with paths=charts/takserver"
    glob = List("charts/takserver/Chart.yaml", "charts/takserver/**/*.yaml", "charts/takserver/**/*.tpl")
  }
  ["helm-cloudtak"] {
    check = "uds run lint:helm --no-progress --with paths=charts/cloudtak"
    glob = List("charts/cloudtak/Chart.yaml", "charts/cloudtak/**/*.yaml", "charts/cloudtak/**/*.tpl")
  }
  ["helm-template-cloudtak"] {
    check = "uds run lint:helm-template --no-progress --with paths=charts/cloudtak"
    glob = List("charts/cloudtak/Chart.yaml", "charts/cloudtak/**/*.yaml", "charts/cloudtak/**/*.tpl")
  }
  ["helm-template"] {
    check = "uds run lint:helm-template --no-progress --with paths=charts/takserver"
    glob = List("charts/takserver/Chart.yaml", "charts/takserver/**/*.yaml", "charts/takserver/**/*.tpl")
  }
  ["zarf-tools"] {
    check = "uds run lint:zarf-tools --no-progress"
    glob = List("zarf.yaml", "common/zarf.yaml")
  }
  ["zarf-lint"] {
    check = "uds zarf dev lint . --flavor upstream --set DOMAIN=uds.dev --set TAK_IMAGE_TAG=5.7-RELEASE-14"
    glob = List("zarf.yaml", "common/zarf.yaml", "charts/takserver/**/*.yaml", "charts/cloudtak/**/*.yaml")
  }
  ["icon"] {
    check = "bash .github/scripts/check-icon.sh"
    glob = List("zarf.yaml", "assets/icon.svg", ".github/scripts/check-icon.sh")
  }
  ["exemptions"] {
    check = "bash .github/scripts/check-exemptions.sh"
    glob = List("charts/takserver/**/*.yaml", "charts/takserver/**/*.tpl", "atak/deploy/*.yaml", "docs/justifications.md", ".github/scripts/check-exemptions.sh")
  }
  ["gitleaks"] {
    check = "gitleaks detect --no-git --config .gitleaks.toml --source . --redact --exit-code 1"
    glob = List("**/*", ".gitleaks.toml", ".gitignore")
  }
  ["key-material"] {
    check = "bash .github/scripts/check-key-material.sh"
    glob = List("**/*", ".gitignore", ".github/scripts/check-key-material.sh")
  }
}
