{
  "name": "takserver-oidc",
  "version": "0.8.0",
  "description": "Prepares TAK Server on UDS Core. Renders CoreConfig at pod admission, sets the startup order and probes, writes the CoreDNS rewrite, and copies the TAK CA and CloudTAK admin certificates",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "pepr": {
    "name": "takserver-oidc",
    "uuid": "c72fcf944a4f43bbb386d22371aa640f",
    "onError": "reject",
    "webhookTimeout": 10,
    "alwaysIgnore": {
      "namespaces": [],
      "labels": []
    },
    "includedFiles": [],
    "peprVersion": "2.0.7",
    "appVersion": "0.8.0",
    "rbacMode": "scoped",
    "rbac": [
      {
        "apiGroups": [
          ""
        ],
        "resources": [
          "namespaces"
        ],
        "verbs": [
          "get",
          "create"
        ]
      }
    ]
  },
  "scripts": {
    "build": "pepr build && node scripts/finalize-chart.mjs",
    "test": "PEPR_MODE=build node --test capabilities/*.test.ts",
    "test:coverage": "PEPR_MODE=build node --test --experimental-test-coverage --test-coverage-include='capabilities/**' --test-coverage-include='scripts/webhook-scope.ts' --test-coverage-exclude='**/*.test.ts' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info capabilities/*.test.ts"
  },
  "dependencies": {
    "pepr": "2.0.7"
  },
  "overrides": {
    "kubernetes-fluent-client": {
      "undici": "8.12.3",
      "js-yaml": "5.4.3",
      "@kubernetes/client-node": {
        "js-yaml": "4.3.2"
      }
    }
  },
  "devDependencies": {
    "fast-check": "4.10.2"
  }
}
