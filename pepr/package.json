  },
  "scripts": {
    "build": "pepr build && node scripts/finalize-chart.mjs",
    "test": "node --test capabilities/*.test.ts"
  },
  "dependencies": {
    "pepr": "2.0.3"
  },
  "overrides": {
    "kubernetes-fluent-client": {
      "undici": "8.10.2",
      "js-yaml": "5.4.2",
      "@kubernetes/client-node": {
        "js-yaml": "4.3.2"
      }
    }
  }
}
