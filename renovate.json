{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    ":dependencyDashboard",
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "helpers:pinGitHubActionDigestsToSemver",
    ":semanticCommits",
    ":semanticPrefixFixDepsChoreOthers",
    "group:all",
    "replacements:all",
    "workarounds:all"
  ],
  "ignorePresets": [
    ":ignoreModulesAndTests"
  ],
  "separateMajorMinor": true,
  "reviewersFromCodeOwners": false,
  "rebaseWhen": "conflicted",
  "commitBodyTable": true,
  "pre-commit": {
    "enabled": true
  },
  "schedule": [
    "after 7am and before 9am every weekday"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "mise.toml pins marked with a # renovate: comment",
      "fileMatch": [
        "(^|/)mise\\.toml$"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\n[^\\n]*?(?:=\\s*\"|version\\s*=\\s*\")(?<currentValue>[^\"]+)\""
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
      "extractVersionTemplate": "{{#if extractVersion}}{{{extractVersion}}}{{else}}^(?<version>.*)${{/if}}"
    },
    {
      "customType": "regex",
      "description": "Concrete image tags in zarf.yaml. Zarf variables such as ###ZARF_VAR_TAK_IMAGE_TAG### do not match.",
      "fileMatch": [
        "(^|/)zarf\\.yaml$"
      ],
      "matchStrings": [
        "-\\s+['\"]?(?<depName>[a-z0-9][a-z0-9._/-]*):(?<currentValue>\\d[^'\"\\s]*)['\"]?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Public TAK-Product-Center/Server release tag",
      "fileMatch": [
        "(^|/)zarf\\.yaml$",
        "(^|/)tasks\\.yaml$",
        "(^|/)uds-config\\.yaml$",
        "(^|/)version\\.txt$",
        "(^|/)Dockerfile$",
        "(^|/)README\\.md$",
        "^docs/.+\\.md$",
        "^values/.+\\.yaml$",
        "^\\.github/workflows/.+\\.ya?ml$"
      ],
      "matchStrings": [
        "(?<currentValue>\\d+\\.\\d+-RELEASE-\\d+)"
      ],
      "datasourceTemplate": "git-tags",
      "depNameTemplate": "https://github.com/TAK-Product-Center/Server",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)-RELEASE-(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Image references pinned to a tag and a digest",
      "fileMatch": [
        "(^|/)Dockerfile$",
        "^\\.github/workflows/.+\\.ya?ml$"
      ],
      "matchStrings": [
        "(?<depName>[a-z0-9][a-z0-9._/-]*):(?<currentValue>[A-Za-z0-9][A-Za-z0-9._-]*)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "GitHub Action SHAs pinned next to a version comment",
      "fileMatch": [
        "^\\.github/workflows/.+\\.ya?ml$"
      ],
      "matchStrings": [
        "uses:\\s*(?<depName>[\\w.-]+/[\\w.-]+)(?:/[\\w./-]+)?@(?<currentDigest>[0-9a-f]{40})\\s+#\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "CloudTAK release tag next to a # cloudtak-version comment. It moves with the upstream/cloudtak submodule.",
      "fileMatch": [
        "(^|/)zarf\\.yaml$",
        "^charts/cloudtak/(values|Chart)\\.yaml$",
        "^\\.github/container-and-chart/cloudtak/docker-bake\\.hcl$"
      ],
      "matchStrings": [
        "(?<currentValue>v\\d+\\.\\d+\\.\\d+)\"?\\s*# cloudtak-version"
      ],
      "depNameTemplate": "dfpc-coe/CloudTAK",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Version after a # renovate: datasource=... comment, as a YAML value or a shell or env assignment",
      "fileMatch": [
        "\\.ya?ml$",
        "\\.sh$",
        "\\.md$",
        "(^|/)Dockerfile$"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?(?: registryUrl=(?<registryUrl>\\S+))?\\n\\s*[\\w-]+\\s*[:=]\\s*['\"]?(?<currentValue>[^'\"\\s]+)['\"]?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}",
      "extractVersionTemplate": "{{#if extractVersion}}{{{extractVersion}}}{{else}}^(?<version>.*)${{/if}}"
    },
    {
      "customType": "regex",
      "description": "OCI package repository and ref in bundle/uds-bundle.yaml",
      "fileMatch": [
        "(^|/)uds-bundle\\.yaml$"
      ],
      "matchStringsStrategy": "recursive",
      "matchStrings": [
        "(?m)repository: [\"']?(?<depName>.+?)[\"']?$(.)*(\\n.*){0,2}ref: [\"']?(?<currentValue>.+?)[\"']?$"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^v?(?<major>\\d+)(\\.(?<minor>\\d+))?(\\.(?<patch>\\d+))?(-uds\\.(?<build>\\d+))?(-(?<compatibility>\\w+)?)?(.*?)?$"
    }
  ],
  "packageRules": [
    {
      "groupName": "TAK Server Support Dependencies",
      "labels": [
        "support-deps"
      ],
      "commitMessageTopic": "support-deps",
      "matchPackageNames": [
        "*"
      ]
    },
    {
      "groupName": "TAK Server Package Dependencies",
      "labels": [
        "package-deps"
      ],
      "commitMessageTopic": "package-deps",
      "matchDatasources": [
        "docker",
        "helm",
        "git-tags"
      ]
    },
    {
      "description": "upstream/takserver follows the public TAK Server release tags. .gitmodules sets branch to the tag, so Renovate moves the tag and the pinned commit together.",
      "matchManagers": [
        "git-submodules"
      ],
      "matchDepNames": [
        "upstream/takserver"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)-RELEASE-(?<patch>\\d+)$",
      "groupName": "TAK Server Package Dependencies",
      "labels": [
        "package-deps"
      ],
      "commitMessageTopic": "package-deps"
    },
    {
      "description": "upstream/cloudtak follows CloudTAK release tags. .gitmodules sets branch to the tag. The image tag strings marked # cloudtak-version move in the same pull request.",
      "matchManagers": [
        "git-submodules",
        "regex"
      ],
      "matchDepNames": [
        "upstream/cloudtak",
        "dfpc-coe/CloudTAK"
      ],
      "versioning": "semver",
      "groupName": "CloudTAK",
      "labels": [
        "package-deps"
      ],
      "commitMessageTopic": "CloudTAK"
    },
    {
      "description": "These image tags are the Zarf variable TAK_IMAGE_TAG, not a registry tag.",
      "matchPackageNames": [
        "ghcr.io/jonathanagustin/uds-k3d-takserver/**"
      ],
      "enabled": false
    },
    {
      "description": "Major updates come in their own pull request, one per dependency, so a breaking upgrade cannot hold back the minor and patch group. group:all turns separateMajorMinor off, so it is turned back on above.",
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": null,
      "addLabels": [
        "major"
      ],
      "commitMessageTopic": "{{depName}}"
    },
    {
      "description": "Majors that need real work before they can land: the PostgreSQL base of the PostGIS image (a new major needs a data migration) and the Java toolchain the TAK build compiles with. They wait for approval on the dependency dashboard.",
      "matchUpdateTypes": [
        "major"
      ],
      "matchPackageNames": [
        "postgres",
        "docker.io/library/postgres",
        "postgis/postgis",
        "docker.io/postgis/postgis",
        "eclipse-temurin",
        "docker.io/library/eclipse-temurin"
      ],
      "dependencyDashboardApproval": true,
      "addLabels": [
        "major",
        "needs-migration"
      ]
    },
    {
      "description": "The Java that mise installs for local Gradle runs is the same toolchain. Its major also waits for approval on the dependency dashboard.",
      "matchDepNames": [
        "java"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true,
      "addLabels": [
        "major",
        "needs-migration"
      ]
    },
    {
      "description": "The NATS images in zarf.yaml are the ones the upstream NATS chart renders. A new NATS server or config reloader has to be checked against that chart, so every update gets its own pull request after approval on the dependency dashboard.",
      "matchPackageNames": [
        "nats",
        "docker.io/library/nats",
        "natsio/nats-server-config-reloader",
        "docker.io/natsio/nats-server-config-reloader"
      ],
      "groupName": "NATS",
      "dependencyDashboardApproval": true,
      "addLabels": [
        "needs-migration"
      ]
    },
    {
      "description": "GitHub-hosted runner images (runs-on). A new Ubuntu release is a major change to every job and waits for approval on the dependency dashboard.",
      "matchDatasources": [
        "github-runners"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "groupName": null,
      "dependencyDashboardApproval": true,
      "addLabels": [
        "major",
        "needs-migration"
      ],
      "commitMessageTopic": "{{depName}}"
    }
  ],
  "git-submodules": {
    "enabled": true
  }
}
