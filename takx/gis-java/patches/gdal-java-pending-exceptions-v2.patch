+/* Scoped input ownership for C++ JNI wrappers, including early typemap returns. */
+%{
+#include "cpl_string.h"
+#ifdef __cplusplus
+namespace {
+class GdalJavaScopedUtfChars {
+    JNIEnv *env_;
+    jstring string_;
+    const char *chars_;
+public:
+    GdalJavaScopedUtfChars(JNIEnv *env, jstring string)
+        : env_(env), string_(string), chars_(string ? env->GetStringUTFChars(string, 0) : NULL) {}
+    ~GdalJavaScopedUtfChars() { if (chars_) env_->ReleaseStringUTFChars(string_, chars_); }
+    const char *get() const { return chars_; }
+    GdalJavaScopedUtfChars(const GdalJavaScopedUtfChars &) = delete;
+    GdalJavaScopedUtfChars &operator=(const GdalJavaScopedUtfChars &) = delete;
+};
+class GdalJavaScopedOptions {
+    char ***slot_;
+public:
+    explicit GdalJavaScopedOptions(char ***slot) : slot_(slot) {}
+    ~GdalJavaScopedOptions() { CSLDestroy(*slot_); }
+    GdalJavaScopedOptions(const GdalJavaScopedOptions &) = delete;
+    GdalJavaScopedOptions &operator=(const GdalJavaScopedOptions &) = delete;
+};
+}
+#define GDAL_JAVA_CSL_TAIL_CLEANUP(list) ((void)0)
+#else
+#define GDAL_JAVA_CSL_TAIL_CLEANUP(list) CSLDestroy(list)
+#endif
+%}
+#ifdef __cplusplus
+%typemap(in, noblock=1) char * {
+  GdalJavaScopedUtfChars $1_utf_guard(jenv, $input);
+  $1 = ($1_ltype)$1_utf_guard.get();
+  if ($input && !$1) return $null;
+}
+%typemap(in, noblock=1) const char * {
+  GdalJavaScopedUtfChars $1_utf_guard(jenv, $input);
+  $1 = ($1_ltype)$1_utf_guard.get();
+  if ($input && !$1) return $null;
+}
+%typemap(freearg, noblock=1) char * "";
+%typemap(freearg, noblock=1) const char * "";
+#endif
