+// Project bridges use distinct native names to preserve the existing URI setter ABI.
+extern "C" JNIEXPORT jboolean JNICALL
+Java_com_atakmap_map_layer_model_SceneLayer_isItemVisible(JNIEnv *env, jclass, jlong ptr, jlong id)
+{
+    if (!ptr) { ATAKMapEngineJNI_checkOrThrow(env, TE_InvalidArg); return false; }
+    auto impl = getLayer(*JLONG_TO_INTPTR(atakmap::core::Layer, ptr));
+    if (!impl) { ATAKMapEngineJNI_checkOrThrow(env, TE_InvalidArg); return false; }
+    return impl->isVisible(id);
+}
+extern "C" JNIEXPORT void JNICALL
+Java_com_atakmap_map_layer_model_SceneLayer_setItemVisible(JNIEnv *env, jclass, jlong ptr, jlong id, jboolean visible)
+{
+    if (!ptr) { ATAKMapEngineJNI_checkOrThrow(env, TE_InvalidArg); return; }
+    auto impl = getLayer(*JLONG_TO_INTPTR(atakmap::core::Layer, ptr));
+    if (!impl) { ATAKMapEngineJNI_checkOrThrow(env, TE_InvalidArg); return; }
+    ATAKMapEngineJNI_checkOrThrow(env, impl->setVisible(id, visible));
+}
+extern "C" JNIEXPORT jobject JNICALL
+Java_com_atakmap_map_layer_model_SceneLayer_queryFeatures(JNIEnv *env, jclass, jlong ptr, jobject mparams)
+{
+    if (!ptr) { ATAKMapEngineJNI_checkOrThrow(env, TE_InvalidArg); return nullptr; }
+    auto impl = getLayer(*JLONG_TO_INTPTR(atakmap::core::Layer, ptr));
+    if (!impl) { ATAKMapEngineJNI_checkOrThrow(env, TE_InvalidArg); return nullptr; }
+    FeatureDataStore2::FeatureQueryParameters params;
+    if (mparams) {
+        TAKErr code = TAKEngineJNI::Interop::Feature::Interop_marshal(&params, *env, mparams);
+        if (env->ExceptionCheck() || ATAKMapEngineJNI_checkOrThrow(env, code)) return nullptr;
+    }
+    FeatureCursorPtr cursor(nullptr, nullptr);
+    TAKErr code = impl->query(cursor, params);
+    if (ATAKMapEngineJNI_checkOrThrow(env, code)) return nullptr;
+    if (!cursor) { ATAKMapEngineJNI_checkOrThrow(env, TE_IllegalState); return nullptr; }
+    // Retain the unique cursor until allocation succeeds; do not leak it on JVM OOM.
+    jobject pointer = env->NewObject(Pointer_class.id, Pointer_class.ctor__JJIJ,
+        INTPTR_TO_JLONG(cursor.get()), INTPTR_TO_JLONG(cursor.get()),
+        com_atakmap_interop_Pointer_UNIQUE, INTPTR_TO_JLONG(cursor.get_deleter()));
+    if (env->ExceptionCheck() || !pointer) return nullptr;
+    cursor.release();
+    return pointer;
+}
