+def compiler_backends(compiler, run):
+    """Ask the selected GCC for its real helpers instead of assuming a host layout."""
+    result={}
+    for name in ('cc1','cc1plus','collect2'):
+        value=run([compiler,'-print-prog-name='+name],'compiler-backend-'+name,15,True).decode('utf-8').strip()
+        path=Path(value)
+        if not path.is_absolute() or not path.is_file():
+            raise ValueError('GCC must identify an existing absolute backend: '+name)
+        path=path.resolve()
+        result[str(path)]=b.native.digest(path)
+    return result
