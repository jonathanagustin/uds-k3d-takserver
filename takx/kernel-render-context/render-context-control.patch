+TAKErr TAK::Engine::Renderer::Shader_releaseContext(const RenderContext& context) NOTHROWS {
+    if (!context.isRenderThread() || !context.isAttached()) return TE_IllegalState;
+    Lock lock(shadersMutex());
+    TE_CHECKRETURN_CODE(lock.status);
+    auto old = shaders().find(&context);
+    if (old != shaders().end()) for (const auto& entry : old->second) {
+        Shader* shader = const_cast<Shader*>(entry.second.get());
+        if (shader->handle != GL_NONE) glDeleteProgram(shader->handle);
+        shader->handle = GL_NONE;
+    }
+    auto modern = shaders2().find(&context);
+    if (modern != shaders2().end()) for (const auto& entry : modern->second) {
+        Shader2* shader = const_cast<Shader2*>(entry.second.get());
+        if (shader->handle != GL_NONE) glDeleteProgram(shader->handle);
+        shader->handle = GL_NONE;
+    }
+    return TE_Ok;
+}
+
+TAKErr TAK::Engine::Renderer::Shader_recreateContext(const RenderContext& context) NOTHROWS {
+    if (!context.isRenderThread() || !context.isAttached()) return TE_IllegalState;
+    std::vector<unsigned> oldFlags, modernFlags;
+    {
+        Lock lock(shadersMutex());
+        TE_CHECKRETURN_CODE(lock.status);
+        auto old = shaders().find(&context);
+        if (old != shaders().end()) for (const auto& entry : old->second) oldFlags.push_back(entry.first);
+        auto modern = shaders2().find(&context);
+        if (modern != shaders2().end()) for (const auto& entry : modern->second) modernFlags.push_back(entry.first);
+    }
+    for (const unsigned flags : oldFlags) {
+        RenderAttributes attrs;
+        attrs.colorPointer = (flags & FLAG_COLOR_POINTER) != 0;
+        attrs.opaque = (flags & FLAG_ALPHA_DISCARD) == 0;
+        attrs.textureIds[0] = (flags & FLAG_TEXTURED) ? 1 : 0;
+        attrs.normals = (flags & FLAG_NORMAL) != 0;
+        attrs.points = (flags & FLAG_POINTS) != 0;
+        std::shared_ptr<const Shader> shader;
+        Shader_get(shader, context, attrs);
+        if (!shader || shader->handle == GL_NONE) return TE_Err;
+    }
+    for (const unsigned flags : modernFlags) {
+        RenderAttributes attrs;
+        attrs.textureIds[0] = (flags & FLAG_TEXTURED) ? 1 : 0;
+        attrs.normals = (flags & FLAG_NORMAL) != 0;
+        std::shared_ptr<const Shader2> shader;
+        const TAKErr code = Shader_get(shader, context, attrs);
+        TE_CHECKRETURN_CODE(code);
+        if (!shader || shader->handle == GL_NONE) return TE_Err;
+    }
+    return TE_Ok;
+}
