+TAKErr TAK::Engine::Renderer::GLWorkers_retire(const RenderContext& context) NOTHROWS {
+    if (!context.isRenderThread() || !context.isAttached()) return TE_IllegalState;
+    // Record retirement even if this context never requested a worker before.
+    // A getter during later cleanup must still return a closed terminal slot.
+    (void)workerCache.get(&context);
+    TAKErr result = TE_Ok;
+    workerCache.visit(&context, [&result](ContextWorkers& workers) {
+        std::shared_ptr<RetirableWorker> resource,thread;
+        {
+            std::lock_guard<std::mutex> lock(workers.mutex);
+            workers.retired=true;
+            resource=workers.resourceLoad;
+            thread=workers.threadWorker;
+        }
+        // Establish both barriers before any cancellation/drain callback runs.
+        for (const auto& worker:{resource,thread}) if (worker) {
+            const TAKErr code=worker->beginRetirement();
+            if (result==TE_Ok) result=code;
+        }
+        if (result!=TE_Ok) return;
+        for (const auto& worker:{resource,thread}) if (worker) {
+            const TAKErr code=worker->retire();
+            if (result==TE_Ok) result=code;
+        }
+        // Keep retired slots so old-context getters cannot create active workers.
+    });
+    return result;
+}
+TAKErr TAK::Engine::Renderer::GLWorkers_resume(const RenderContext& context) NOTHROWS {
+    if (!context.isRenderThread() || !context.isAttached()) return TE_IllegalState;
+    TAKErr result=TE_Ok;
+    workerCache.visit(&context, [&result](ContextWorkers& workers) {
+        std::shared_ptr<RetirableWorker> oldResource,oldThread;
+        {
+            std::lock_guard<std::mutex> lock(workers.mutex);
+            if ((workers.resourceLoad && (!workers.retired || !workers.resourceLoad->closed())) ||
+                (workers.threadWorker && (!workers.retired || !workers.threadWorker->closed()))) {
+                result=TE_IllegalState;
+                return;
+            }
+            oldResource.swap(workers.resourceLoad);
+            oldThread.swap(workers.threadWorker);
+            workers.retired=false;
+        }
+        // Held old references remain closed. New getters create genuine workers.
+    });
+    return result;
+}
