+TextureFillStyle::TextureFillStyle(const char *uri_, unsigned int color_, int rx, int ry,
+                                 int w, int h, float degrees, bool north) :
+    Style(TESC_TextureFillStyle), uri(uri_), color(color_), repeatX(rx), repeatY(ry),
+    width(w), height(h), rotation(degrees), absolute(north)
+{
+    if (!uri_ || !*uri_ || std::strlen(uri_) > 8192u ||
+        (rx != Repeat && rx != Stretch) || (ry != Repeat && ry != Stretch) ||
+        w <= 0 || h <= 0 || w > 32768 || h > 32768 || !std::isfinite(degrees))
+        throw std::invalid_argument("invalid texture fill parameters");
+}
+Style *TextureFillStyle::clone() const { return new TextureFillStyle(*this); }
+bool TextureFillStyle::equalsImpl(const Style &other) const NOTHROWS
+{
+    if (other.getClass() != getClass()) return false;
+    const auto &b = static_cast<const TextureFillStyle &>(other);
+    return std::strcmp(uri, b.uri) == 0 && color == b.color && repeatX == b.repeatX &&
+        repeatY == b.repeatY && width == b.width && height == b.height &&
+        rotation == b.rotation && absolute == b.absolute;
+}
+TAKErr TextureFillStyle::toOGR(Port::String &value) const NOTHROWS
+{
+    try {
+        // Explicit project extension in an OGR BRUSH id. Hex URI avoids delimiters/escaping ambiguity.
+        std::ostringstream out;
+        out.imbue(std::locale::classic());
+        out << "BRUSH(id:\"uds-tak-texture-v1:";
+        const char *hex = "0123456789abcdef";
+        for (const unsigned char *p = reinterpret_cast<const unsigned char *>(static_cast<const char *>(uri)); *p; ++p)
+            out << hex[*p >> 4] << hex[*p & 15];
+        out << ':' << repeatX << ':' << repeatY << ':' << width << ':' << height << ':'
+            << std::setprecision(std::numeric_limits<float>::max_digits10) << rotation << ':'
+            << (absolute ? 1 : 0) << "\",fc:" << OGR_Color(color) << ')';
+        value = out.str().c_str();
+        return TE_Ok;
+    } catch (...) { return TE_Err; }
+}
+TextureFillStyle *TextureFillStyle::parseProjectBrush(const char *name, unsigned int color)
+{
+    const std::string prefix("uds-tak-texture-v1:");
+    if (!name || std::strncmp(name, prefix.c_str(), prefix.size()) != 0) return nullptr;
+    std::istringstream input(name + prefix.size());
+    input.imbue(std::locale::classic());
+    std::string encoded, text;
+    if (!std::getline(input, encoded, ':') || encoded.empty() || encoded.size() > 16384u || encoded.size()%2)
+        throw std::invalid_argument("invalid texture URI encoding");
+    for (std::size_t i = 0; i < encoded.size(); i += 2) {
+        auto nibble = [](char ch) -> int { return ch >= '0' && ch <= '9' ? ch-'0' : ch >= 'a' && ch <= 'f' ? ch-'a'+10 : -1; };
+        const int a = nibble(encoded[i]), b = nibble(encoded[i+1]);
+        if (a < 0 || b < 0 || !(a || b)) throw std::invalid_argument("invalid texture URI encoding");
+        text.push_back(static_cast<char>((a<<4)|b));
+    }
+    int rx, ry, w, h, north; float degrees; char a,b,c,d,e;
+    if (!(input >> rx >> a >> ry >> b >> w >> c >> h >> d >> degrees >> e >> north) ||
+        a != ':' || b != ':' || c != ':' || d != ':' || e != ':' ||
+        (north != 0 && north != 1) || input.peek() != std::char_traits<char>::eof())
+        throw std::invalid_argument("invalid texture fill encoding");
+    return new TextureFillStyle(text.c_str(), color, rx, ry, w, h, degrees, north != 0);
+}
