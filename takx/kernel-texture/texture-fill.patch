+package com.atakmap.map.layer.feature.style;
+
+import com.atakmap.interop.Pointer;
+
+/**
+ * Project public-source texture fill. Width/height are positive display pixels;
+ * rotation is clockwise degrees. Absolute rotation is relative to map north,
+ * otherwise to the screen. This does not claim private Kernel binary compatibility.
+ */
+public final class TextureFillStyle extends Style {
+    public static final int REPEATTYPE_REPEAT = 0;
+    public static final int REPEATTYPE_STRETCH = 1;
+
+    public TextureFillStyle(String uri, int color, int repeatTypeX, int repeatTypeY,
+                            int width, int height, float rotation, boolean isAbsolute) {
+        this(create(uri, color, repeatTypeX, repeatTypeY, width, height, rotation, isAbsolute), null);
+    }
+    TextureFillStyle(Pointer pointer, Object owner) { super(pointer, owner); }
+    public String getUri() { rwlock.acquireRead(); try { return uri(pointer.raw); } finally { rwlock.releaseRead(); } }
+    public int getColor() { return integer(0); }
+    public int getRepeatTypeX() { return integer(1); }
+    public int getRepeatTypeY() { return integer(2); }
+    public int getWidth() { return integer(3); }
+    public int getHeight() { return integer(4); }
+    public float getRotation() { rwlock.acquireRead(); try { return rotation(pointer.raw); } finally { rwlock.releaseRead(); } }
+    public boolean isAbsolute() { return integer(5) != 0; }
+    private int integer(int field) { rwlock.acquireRead(); try { return integer(pointer.raw, field); } finally { rwlock.releaseRead(); } }
+    static native int nativeClass();
+    private static native Pointer create(String uri, int color, int rx, int ry, int width, int height, float rotation, boolean absolute);
+    private static native String uri(long ptr);
+    private static native int integer(long ptr, int field);
+    private static native float rotation(long ptr);
+}
