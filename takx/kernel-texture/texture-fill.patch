+#ifndef TAK_ENGINE_RENDERER_TEXTUREFILLMATH_H
+#define TAK_ENGINE_RENDERER_TEXTUREFILLMATH_H
+#include <array>
+#include <cmath>
+#include <limits>
+namespace TAK { namespace Engine { namespace Renderer { namespace Feature {
+struct TextureFillFrame {
+    std::array<double, 2> origin;
+    double cosine, sine;
+    std::array<double, 4> bounds{{std::numeric_limits<double>::infinity(), std::numeric_limits<double>::infinity(),
+                                -std::numeric_limits<double>::infinity(), -std::numeric_limits<double>::infinity()}};
+    static bool project(std::array<double,2> &out, const float *m, double x, double y, double z, const int *viewport) {
+        const double w=m[3]*x+m[7]*y+m[11]*z+m[15];
+        if (!std::isfinite(w) || w <= 0.0 || viewport[2] <= 0 || viewport[3] <= 0) return false;
+        out={{viewport[0]+((m[0]*x+m[4]*y+m[8]*z+m[12])/w+1.0)*viewport[2]*0.5,
+              viewport[1]+((m[1]*x+m[5]*y+m[9]*z+m[13])/w+1.0)*viewport[3]*0.5}};
+        return std::isfinite(out[0]) && std::isfinite(out[1]);
+    }
+    bool initialize(const std::array<double,2> &a, const std::array<double,2> &north, double degrees, bool absolute) {
+        origin=a;
+        const double dx=north[0]-a[0],dy=north[1]-a[1];
+        if (!std::isfinite(degrees) || (absolute && std::hypot(dx,dy)<1e-9)) return false;
+        const double angle=degrees*(3.14159265358979323846/180.0)+(absolute ? std::atan2(dx,dy):0.0);
+        cosine=std::cos(angle); sine=std::sin(angle);
+        return true;
+    }
+    std::array<double,2> rotate(const std::array<double,2> &p) const {
+        const double x=p[0]-origin[0],y=p[1]-origin[1];
+        return {{cosine*x-sine*y,sine*x+cosine*y}};
+    }
+    void include(const std::array<double,2> &p) {
+        const auto q=rotate(p);
+        for (int i=0;i<2;i++) { if(q[i]<bounds[i])bounds[i]=q[i]; if(q[i]>bounds[i+2])bounds[i+2]=q[i]; }
+    }
+    bool valid() const { return std::isfinite(bounds[0]) && std::isfinite(bounds[1]) && bounds[2]>bounds[0] && bounds[3]>bounds[1]; }
+    bool sample(std::array<double,2> &uv,const std::array<double,2> &p,const int *repeat,const float *dimensions) const {
+        if (!valid()) return false;
+        const auto q=rotate(p);
+        for(int i=0;i<2;i++) {
+            if (repeat[i]==0 && dimensions[i]>0) { const double t=q[i]/dimensions[i];uv[i]=t-std::floor(t); }
+            else if(repeat[i]==1) { const double t=(q[i]-bounds[i])/(bounds[i+2]-bounds[i]); uv[i]=t<0?0:t>1?1:t; }
+            else return false;
+        }
+        return true;
+    }
+};
+}}}}
+#endif
