+// Public-source project texture fill; real Style ownership and native class dispatch.
+extern "C" {
+JNIEXPORT jint JNICALL Java_com_atakmap_map_layer_feature_style_TextureFillStyle_nativeClass(JNIEnv *, jclass)
+{ return TESC_TextureFillStyle; }
+JNIEXPORT jobject JNICALL Java_com_atakmap_map_layer_feature_style_TextureFillStyle_create(
+    JNIEnv *env, jclass, jstring juri, jint color, jint rx, jint ry, jint width, jint height, jfloat rotation, jboolean absolute)
+{
+    if (!juri) { ATAKMapEngineJNI_checkOrThrow(env, TE_InvalidArg); return nullptr; }
+    JNIStringUTF uri(*env, juri);
+    if (env->ExceptionCheck()) return nullptr;
+    try {
+        StylePtr result(new TextureFillStyle(uri, color, rx, ry, width, height, rotation, absolute), Style::destructStyle);
+        return NewPointer(env, std::move(result));
+    } catch (const std::invalid_argument &) { ATAKMapEngineJNI_checkOrThrow(env, TE_InvalidArg); }
+      catch (...) { ATAKMapEngineJNI_checkOrThrow(env, TE_Err); }
+    return nullptr;
+}
+JNIEXPORT jstring JNICALL Java_com_atakmap_map_layer_feature_style_TextureFillStyle_uri(JNIEnv *env, jclass, jlong ptr)
+{
+    const Style *s = JLONG_TO_INTPTR(Style, ptr);
+    if (!s || s->getClass() != TESC_TextureFillStyle) { ATAKMapEngineJNI_checkOrThrow(env, TE_InvalidArg); return nullptr; }
+    return env->NewStringUTF(static_cast<const TextureFillStyle *>(s)->getUri());
+}
+JNIEXPORT jint JNICALL Java_com_atakmap_map_layer_feature_style_TextureFillStyle_integer(JNIEnv *env, jclass, jlong ptr, jint field)
+{
+    const Style *s = JLONG_TO_INTPTR(Style, ptr);
+    if (!s || s->getClass() != TESC_TextureFillStyle) { ATAKMapEngineJNI_checkOrThrow(env, TE_InvalidArg); return 0; }
+    const auto &t = static_cast<const TextureFillStyle &>(*s);
+    switch (field) {
+    case 0: return t.getColor(); case 1: return t.getRepeatTypeX(); case 2: return t.getRepeatTypeY();
+    case 3: return t.getWidth(); case 4: return t.getHeight(); case 5: return t.isAbsolute();
+    default: ATAKMapEngineJNI_checkOrThrow(env, TE_InvalidArg); return 0;
+    }
+}
+JNIEXPORT jfloat JNICALL Java_com_atakmap_map_layer_feature_style_TextureFillStyle_rotation(JNIEnv *env, jclass, jlong ptr)
