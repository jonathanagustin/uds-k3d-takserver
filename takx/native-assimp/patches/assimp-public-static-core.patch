+# Public Linux source profile: use only the separately verified static zlib.
+if(NOT PUBLIC_ZLIB_PREFIX)
+  message(FATAL_ERROR "PUBLIC_ZLIB_PREFIX must name the source-built zlib prefix")
+endif()
+get_filename_component(_public_zlib_prefix "${PUBLIC_ZLIB_PREFIX}" REALPATH)
+find_path(PUBLIC_ZLIB_INCLUDE NAMES zlib.h
+  PATHS "${_public_zlib_prefix}/include" NO_DEFAULT_PATH REQUIRED)
+find_file(PUBLIC_ZLIB_LIBRARY NAMES libz.a
+  PATHS "${_public_zlib_prefix}/lib" NO_DEFAULT_PATH REQUIRED)
+get_filename_component(_public_zlib_include "${PUBLIC_ZLIB_INCLUDE}" REALPATH)
+get_filename_component(_public_zlib_library "${PUBLIC_ZLIB_LIBRARY}" REALPATH)
+if(NOT _public_zlib_include STREQUAL "${_public_zlib_prefix}/include" OR
+   NOT _public_zlib_library STREQUAL "${_public_zlib_prefix}/lib/libz.a")
+  message(FATAL_ERROR "zlib headers/library must remain inside the verified prefix")
+endif()
+set(ZLIB_INCLUDE_DIR "${_public_zlib_include}")
+set(ZLIB_LIBRARIES "${_public_zlib_library}")
+set(ZLIB_LIBRARIES_LINKED "${_public_zlib_library}")
+add_definitions(-DASSIMP_BUILD_NO_OWN_ZLIB)
+include_directories(${ZLIB_INCLUDE_DIR})
+
+# Build the genuine bundled unzip implementation, without host minizip discovery.
+set(UNZIP_FOUND FALSE)
 
