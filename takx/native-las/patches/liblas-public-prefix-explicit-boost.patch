+# Project public-source profile: resolve only the actual source-built LASzip prefix.
+if(NOT DEFINED PUBLIC_LASZIP_PREFIX)
+  message(FATAL_ERROR "PUBLIC_LASZIP_PREFIX must identify the reviewed source-built LASzip output")
+endif()
+find_path(LASZIP_INCLUDE_DIR NAMES laszip/laszip.hpp
+  PATHS "${PUBLIC_LASZIP_PREFIX}/include" NO_DEFAULT_PATH REQUIRED)
+set(_public_library_suffixes "${CMAKE_FIND_LIBRARY_SUFFIXES}")
+set(CMAKE_FIND_LIBRARY_SUFFIXES ".a")
+find_library(LASZIP_LIBRARY NAMES laszip
+  PATHS "${PUBLIC_LASZIP_PREFIX}/lib" NO_DEFAULT_PATH REQUIRED)
+set(CMAKE_FIND_LIBRARY_SUFFIXES "${_public_library_suffixes}")
+file(REAL_PATH "${PUBLIC_LASZIP_PREFIX}" _public_laszip_prefix)
+file(REAL_PATH "${LASZIP_INCLUDE_DIR}/laszip/laszip.hpp" _public_laszip_header)
+file(REAL_PATH "${LASZIP_LIBRARY}" _public_laszip_library)
+string(FIND "${_public_laszip_header}" "${_public_laszip_prefix}/" _public_header_index)
+string(FIND "${_public_laszip_library}" "${_public_laszip_prefix}/" _public_library_index)
+if(NOT _public_header_index EQUAL 0 OR NOT _public_library_index EQUAL 0 OR
+    NOT _public_laszip_library MATCHES "[.]a$")
+  message(FATAL_ERROR "LASzip must resolve to the real static source-built prefix")
+endif()
+set(LASZIP_VERSION "3.4.3")
+set(LASZIP_FOUND TRUE)
+
 
