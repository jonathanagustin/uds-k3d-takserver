+CommoResult ContactManager::configKnownEndpointForContact(
+        const ContactUID *contact, const char *callsign, const char *streamId)
+{
+    if (!contact || !contact->contactUID || !contact->contactUIDLen ||
+            ((callsign == NULL) != (streamId == NULL)))
+        return COMMO_ILLEGAL_ARGUMENT;
+    if (streamId) {
+        if (!*callsign || !*streamId) return COMMO_ILLEGAL_ARGUMENT;
+        try {
+            // Validates the configured stream even before DNS/connect succeeds.
+            streamMgmt->isEndpointSSL(streamId);
+        } catch (std::invalid_argument &) { return COMMO_ILLEGAL_ARGUMENT; }
+    }
+    thread::WriteLock lock(contactMapMutex);
+    ContactMap::iterator iter = contacts.find(contact);
+    if (iter == contacts.end()) {
+        if (!streamId) return COMMO_ILLEGAL_ARGUMENT;
+        ContactUID *uid = new InternalContactUID(contact);
+        iter = contacts.insert(std::make_pair(uid, new ContactState(false))).first;
+        queueContactPresenceChange(uid, true);
+    }
+    ContactState *state = iter->second;
+    bool remove = false;
+    {
+        thread::Lock stateLock(state->mutex);
+        delete state->configuredStreamEndpoint;
+        state->configuredStreamEndpoint = streamId ? new StreamingCoTEndpoint(streamId) : NULL;
+        state->configuredCallsign = callsign ? callsign : "";
+        remove = !streamId && !state->streamEndpoint && !state->datagramEndpoint &&
+                 !state->tcpEndpoint && !state->quicEndpoint;
+    }
+    if (remove) {
+        queueContactPresenceChange(iter->first, false);
+        delete (const InternalContactUID *)iter->first;
+        contacts.erase(iter);
+        delete state;
+    }
+    return COMMO_SUCCESS;
+}
