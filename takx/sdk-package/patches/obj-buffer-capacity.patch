+    private static ByteBuffer reallocate(ByteBuffer src, int required, int growth)
+    {
+        // Small valid OBJ files can have an estimated growth smaller than one
+        // complete vertex/index tuple. Reserve the entire pending tuple.
+        long minimum = (long) src.position() + required;
+        long geometric = (long) src.capacity() + Math.max(growth, src.capacity() / 2);
+        long capacity = Math.max(minimum, geometric);
+        if (required < 0 || capacity > Integer.MAX_VALUE)
+            throw new IllegalArgumentException("OBJ buffer capacity exceeds supported range");
+        ByteBuffer dst = Unsafe.allocateDirect((int) capacity);
         dst.order(ByteOrder.nativeOrder());
         src.flip();
         // XXX - is it quicker to do a memcpy?
