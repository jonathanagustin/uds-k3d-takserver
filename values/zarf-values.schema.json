{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["global", "tak", "dns"],
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain"],
      "properties": {
        "domain": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tak": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imageTag", "plugins"],
      "properties": {
        "imageTag": {
          "type": "string",
          "minLength": 1
        },
        "plugins": {
          "type": "object",
          "additionalProperties": false,
          "required": ["memoryRequest", "memoryLimit"],
          "properties": {
            "memoryRequest": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|k|M|G|T)?|###ZARF_VAR_PLUGINS_MEMORY_REQUEST###)$"
            },
            "memoryLimit": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|k|M|G|T)?|###ZARF_VAR_PLUGINS_MEMORY_LIMIT###)$"
            }
          }
        }
      }
    },
    "dns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inCluster", "passthroughHosts"],
      "properties": {
        "inCluster": {
          "type": "string",
          "pattern": "^(true|false|###ZARF_VAR_IN_CLUSTER_DNS###)$"
        },
        "passthroughHosts": {
          "type": "string"
        }
      }
    }
  }
}
